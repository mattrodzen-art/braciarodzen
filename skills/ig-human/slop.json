   "fix": "Rozbij na dwa zdania albo wytnij słabszą połowę."
  },
  {
   "id": "to-nie-x",
   "regex": "(?i)\\bto nie (?:jest )?[^.!?\\n]{2,50}[,.–-]\\s*to (?:jest )?\\w",
